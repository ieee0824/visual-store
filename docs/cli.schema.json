{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visual-store.invalid/schema/cli-v1.json",
  "title": "Visual Store CLI v1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "ok": {
          "const": true
        },
        "data": {
          "oneOf": [
            {
              "$ref": "#/$defs/init"
            },
            {
              "$ref": "#/$defs/put"
            },
            {
              "$ref": "#/$defs/info"
            },
            {
              "$ref": "#/$defs/list"
            },
            {
              "$ref": "#/$defs/get"
            },
            {
              "$ref": "#/$defs/verify"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "ok",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "ok": {
          "const": false
        },
        "error": {
          "$ref": "#/$defs/error"
        },
        "data": {
          "$ref": "#/$defs/verify"
        }
      },
      "required": [
        "schema_version",
        "ok",
        "error"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "init": {
      "type": "object",
      "properties": {
        "store_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "schema_version": {
          "const": 1
        },
        "already_initialized": {
          "type": "boolean"
        }
      },
      "required": [
        "store_id",
        "schema_version",
        "already_initialized"
      ],
      "additionalProperties": false
    },
    "put": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^visual://[0-9a-f-]{36}/images/[0-9a-f-]{36}$"
        },
        "image_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "run": {
          "type": [
            "string",
            "null"
          ]
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "source_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "stored_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "source_retained": {
          "type": "boolean"
        },
        "compression_applied": {
          "type": "boolean"
        },
        "blob_reused": {
          "type": "boolean"
        },
        "record_reused": {
          "type": "boolean"
        }
      },
      "required": [
        "ref",
        "image_id",
        "run",
        "seq",
        "width",
        "height",
        "source_bytes",
        "stored_bytes",
        "source_retained",
        "compression_applied",
        "blob_reused",
        "record_reused"
      ],
      "additionalProperties": false
    },
    "info": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^visual://[0-9a-f-]{36}/images/[0-9a-f-]{36}$"
        },
        "image_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "run": {
          "type": [
            "string",
            "null"
          ]
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "source_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "stored_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "source_retained": {
          "type": "boolean"
        },
        "compression_applied": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string"
        },
        "captured_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "uniqueItems": true
        },
        "bit_depth": {
          "const": 8
        },
        "color_type": {
          "enum": [
            2,
            6
          ]
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "stored_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scanline_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "non_idat_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pixel_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "encoding_version": {
          "type": "string"
        },
        "compression_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        }
      },
      "required": [
        "ref",
        "image_id",
        "run",
        "seq",
        "width",
        "height",
        "source_bytes",
        "stored_bytes",
        "source_retained",
        "compression_applied",
        "created_at",
        "captured_at",
        "label",
        "note",
        "tags",
        "bit_depth",
        "color_type",
        "source_sha256",
        "stored_sha256",
        "scanline_sha256",
        "non_idat_sha256",
        "pixel_sha256",
        "encoding_version",
        "compression_level"
      ],
      "additionalProperties": false
    },
    "list": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^visual://[0-9a-f-]{36}/images/[0-9a-f-]{36}$"
              },
              "seq": {
                "type": "integer",
                "minimum": 1
              },
              "run": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "created_at": {
                "type": "string"
              },
              "stored_bytes": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "ref",
              "seq",
              "run",
              "label",
              "width",
              "height",
              "created_at",
              "stored_bytes"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "next_cursor": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "get": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^visual://[0-9a-f-]{36}/images/[0-9a-f-]{36}$"
        },
        "path": {
          "type": "string"
        },
        "media_type": {
          "const": "image/png"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "variant": {
          "enum": [
            "stored",
            "source"
          ]
        },
        "displayed": {
          "const": false
        }
      },
      "required": [
        "ref",
        "path",
        "media_type",
        "width",
        "height",
        "byte_length",
        "sha256",
        "variant",
        "displayed"
      ],
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "store_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "images_checked": {
          "type": "integer",
          "minimum": 0
        },
        "blobs_checked": {
          "type": "integer",
          "minimum": 0
        },
        "error_count": {
          "type": "integer",
          "minimum": 0
        },
        "unreferenced_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "issue_count": {
          "type": "integer",
          "minimum": 0
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "blob_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "code"
            ],
            "additionalProperties": false
          },
          "maxItems": 20
        },
        "valid": {
          "type": "boolean"
        }
      },
      "required": [
        "store_id",
        "images_checked",
        "blobs_checked",
        "error_count",
        "unreferenced_candidates",
        "issue_count",
        "issues",
        "valid"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^E_[A-Z_]+$"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    }
  }
}
